{
  "$schema": "https://raw.githubusercontent.com/ScoopInstaller/Scoop/master/schema.json",
  "version": "{{VERSION}}",
  "description": "Deploy and manage NaijaCloud hosting from the terminal, and over MCP",
  "homepage": "https://naijacloud.com",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": "{{RELEASE_BASE}}/naijacloud_{{VERSION}}_windows_amd64.zip",
      "hash": "{{SHA256_WINDOWS_AMD64}}"
    }
  },
  "bin": [
    "naijacloud.exe",
    [
      "naijacloud.exe",
      "njc"
    ]
  ],
  "notes": "Also installed as 'njc', a short alias for the same command.",
  "checkver": {
    "github": "https://github.com/{{REPO_SLUG}}"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/{{REPO_SLUG}}/releases/download/v$version/naijacloud_$version_windows_amd64.zip"
      }
    },
    "hash": {
      "url": "https://github.com/{{REPO_SLUG}}/releases/download/v$version/naijacloud_$version_checksums.txt"
    }
  }
}
