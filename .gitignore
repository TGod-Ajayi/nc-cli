# Dependencies
node_modules/

# Build output — regenerated by `npm run build` (and by the `prepare` hook on
# install). Still published to npm: package.json's "files" field takes
# precedence over .gitignore when packing.
build/
*.tsbuildinfo

# Credentials — the real store is ~/.naijacloud/config.json, outside the repo.
# These patterns are here so a stray local copy or a scratch token file can
# never be committed by accident.
.naijacloud/
config.json
.env
.env.*
!.env.example

# Logs and caches
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/
.eslintcache

# Test and coverage output
coverage/
.nyc_output/

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
